# Optional: prefill the publishable key so you do not paste it each run.
# Must be the PLATFORM publishable key from the SAME sandbox account as the
# secret key used to create the subscription. This is a destination charge,
# so you use the platform key (no stripeAccount option).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Optional: creditor name shown in the SEPA Direct Debit mandate text on the
# SEPA tab. Use the legal entity that appears on the customer's bank statement.
# Defaults to "this business".
VITE_SEPA_CREDITOR_NAME=Your Company GmbH

# Optional: EWCS only. The JTL app-service endpoint that step 9b calls inside
# checkout.runServerUpdate() -- VIES verify, resolveManualTax, and
# checkout.sessions.update with the swapped txr_ rate. It is POSTed
# { sessionId, vatId, businessName, address }.
#
# Left empty, the SPA still runs runServerUpdate and its pending state, but only
# sleeps through the round trip: re-pricing needs a secret key, and there is no
# backend in this repo.
VITE_EWCS_BILLING_ENDPOINT=
